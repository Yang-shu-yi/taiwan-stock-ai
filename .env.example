# AI API Keys (optional, reserved for future ranking/report extensions)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Report bot notifications
ENABLE_REPORT_TELEGRAM=true
ENABLE_LINE=true
REPORT_NOTIFY_ERRORS=false
REPORT_DASHBOARD_URL=https://taiwan-stock-ai-pi.vercel.app/
VERCEL_SNAPSHOT_URL=
BLOB_READ_WRITE_TOKEN=
ENABLE_DASHBOARD_PUBLISH=true
DASHBOARD_BLOB_PATH=dashboard/latest.json
REPORT_TELEGRAM_BOT_TOKEN=YOUR_REPORT_TELEGRAM_BOT_TOKEN
REPORT_TELEGRAM_CHAT_ID=YOUR_REPORT_TELEGRAM_CHAT_ID

LINE_CHANNEL_TOKEN=YOUR_LINE_CHANNEL_TOKEN
LINE_TARGET_ID=YOUR_LINE_TARGET_ID

# Google Sheets (optional)
ENABLE_GOOGLE_SHEETS=false
SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Pipeline mode: AUTO, PRE, POST
MODE=AUTO
DRY_RUN=false
EXECUTION_ENVIRONMENT=live
RUN_TYPE=scheduled

# Versioned signal/performance contract
STRATEGY_VERSION=tw-entry-v1
PERFORMANCE_PRIMARY_HORIZON=5
RESEARCH_SNAPSHOT_FILE=runtime/research_daily_candidates.json
LAST_VALID_SNAPSHOT_FILE=runtime/last_valid_daily_candidates.json

# Cost assumptions (decimal fraction of notional; override with your broker's actual rates)
BROKER_COMMISSION_RATE=0.001425
STOCK_SELL_TAX_RATE=0.003
SLIPPAGE_RATE=0.0005

# Candidate snapshot
DAILY_CANDIDATES_FILE=runtime/daily_candidates.json
TW_SCAN_LIMIT=48
TW_CANDIDATE_LIMIT=8
ACTIONABLE_CANDIDATE_LIMIT=5
EARLY_WATCH_LIMIT=5
TW_EXTRA_CODES=
TW_DYNAMIC_MARKET_LIMIT=12
TW_DYNAMIC_NEWS_LIMIT=12
US_CONTEXT_LIMIT=16
US_CONTEXT_TOP=6
US_CONTEXT_SYMBOLS=

# Small/mid-cap quality radar
ENABLE_SMALL_MID_RADAR=true
SMALL_MID_SHADOW_MODE=true
SMALL_MID_SCAN_LIMIT=24
SMALL_MID_LIMIT=8
SMALL_MID_PROMOTE_LIMIT=0
SMALL_MID_CODES=
SMALL_MID_EXTRA_CODES=
SMALL_MID_MIN_TURNOVER_MILLION=30
SMALL_MID_IDEAL_MAX_PRICE=200
SMALL_MID_MAX_PRICE=500
SMALL_MID_MARKET_CAP_MIN_BILLION=5
SMALL_MID_MARKET_CAP_MAX_BILLION=80
SMALL_MID_HARD_MARKET_CAP_MAX_BILLION=250

# Walk-forward research baseline (always shadow-only)
MODEL_OUTCOME_HORIZON=5
MODEL_MIN_TRAIN_DATES=40
MODEL_TEST_DATES=10
MODEL_GAP_DATES=5
MODEL_MIN_OBSERVATIONS=120
MODEL_MIN_FOLDS=3
OPTIMIZER_MIN_SIGNAL_DATES=20
RESEARCH_MIN_SIGNAL_DATES=60

# Portfolio risk assumptions
RISK_ASSUMED_PORTFOLIO_TWD=1000000
RISK_MAX_NAME_WEIGHT=0.20
RISK_MAX_THEME_WEIGHT=0.35
RISK_MAX_INDUSTRY_WEIGHT=0.35
RISK_MAX_ONE_WAY_TURNOVER=0.60
RISK_MAX_ADV_PARTICIPATION=0.02
RISK_MAX_DRAWDOWN_PCT=-15

# Intraday alert settings
INTRADAY_FOCUS_LIMIT=12
INTRADAY_CHECK_INTERVAL_SEC=60
INTRADAY_PRICE_UP_PCT=2.0
INTRADAY_PRICE_DOWN_PCT=-2.0
INTRADAY_RSI_OVERBOUGHT=70
INTRADAY_RSI_OVERSOLD=30
INTRADAY_VOLUME_SPIKE_MULT=2.0
INTRADAY_ALERT_COOLDOWN_MIN=30
INTRADAY_TG_POLL_SEC=10
