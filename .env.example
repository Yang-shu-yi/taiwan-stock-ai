# AI API Keys (optional, reserved for future ranking/report extensions)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Report bot notifications
ENABLE_REPORT_TELEGRAM=true
ENABLE_LINE=true
REPORT_NOTIFY_ERRORS=false
REPORT_DASHBOARD_URL=https://taiwan-stock-ai.vercel.app/
VERCEL_SNAPSHOT_URL=
BLOB_READ_WRITE_TOKEN=
REPORT_TELEGRAM_BOT_TOKEN=YOUR_REPORT_TELEGRAM_BOT_TOKEN
REPORT_TELEGRAM_CHAT_ID=YOUR_REPORT_TELEGRAM_CHAT_ID

LINE_CHANNEL_TOKEN=YOUR_LINE_CHANNEL_TOKEN
LINE_TARGET_ID=YOUR_LINE_TARGET_ID

# Google Sheets (optional)
ENABLE_GOOGLE_SHEETS=false
SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Pipeline mode: AUTO, PRE, POST
MODE=AUTO

# Candidate snapshot
DAILY_CANDIDATES_FILE=runtime/daily_candidates.json
TW_SCAN_LIMIT=48
TW_CANDIDATE_LIMIT=8
TW_EXTRA_CODES=
TW_DYNAMIC_MARKET_LIMIT=12
TW_DYNAMIC_NEWS_LIMIT=12
US_CONTEXT_LIMIT=16
US_CONTEXT_TOP=6
US_CONTEXT_SYMBOLS=

# Small/mid-cap quality radar
ENABLE_SMALL_MID_RADAR=true
SMALL_MID_SCAN_LIMIT=24
SMALL_MID_LIMIT=8
SMALL_MID_PROMOTE_LIMIT=2
SMALL_MID_CODES=
SMALL_MID_EXTRA_CODES=
SMALL_MID_MIN_TURNOVER_MILLION=30
SMALL_MID_IDEAL_MAX_PRICE=200
SMALL_MID_MAX_PRICE=500
SMALL_MID_MARKET_CAP_MIN_BILLION=5
SMALL_MID_MARKET_CAP_MAX_BILLION=80
SMALL_MID_HARD_MARKET_CAP_MAX_BILLION=250

# Intraday alert settings
INTRADAY_FOCUS_LIMIT=12
INTRADAY_CHECK_INTERVAL_SEC=60
INTRADAY_PRICE_UP_PCT=2.0
INTRADAY_PRICE_DOWN_PCT=-2.0
INTRADAY_RSI_OVERBOUGHT=70
INTRADAY_RSI_OVERSOLD=30
INTRADAY_VOLUME_SPIKE_MULT=2.0
INTRADAY_ALERT_COOLDOWN_MIN=30
INTRADAY_TG_POLL_SEC=10
